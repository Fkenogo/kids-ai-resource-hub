rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminRolePath() {
      return /databases/$(database)/documents/user_roles/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminRolePath())
        && (
          get(adminRolePath()).data.role == 'admin'
          || get(adminRolePath()).data.role == 'moderator'
        );
    }

    function matchesProfileUser(profileId) {
      return signedIn() && (
        profileId == request.auth.uid
        || (
          request.auth.token.email != null
          && exists(/databases/$(database)/documents/profiles/$(profileId))
          && get(/databases/$(database)/documents/profiles/$(profileId)).data.email == request.auth.token.email
        )
      );
    }

    match /profiles/{profileId} {
      // Full profile documents contain private fields (email). Only the owner
      // and admins may read them; public author data lives in public_profiles.
      allow get: if matchesProfileUser(profileId) || isAdmin();
      // The app resolves legacy profile ids by matching the signed-in email.
      // Queries must be constrained to the caller's own email.
      allow list: if isAdmin()
        || (
          signedIn()
          && request.auth.token.email != null
          && resource.data.email == request.auth.token.email
        );
      allow create: if signedIn() && request.auth.uid == profileId;
      allow update: if matchesProfileUser(profileId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /public_profiles/{profileId} {
      // Intended public author fields only. Never add email or private data here.
      allow read: if true;
      allow create, update: if (isAdmin() || matchesProfileUser(profileId))
        && request.resource.data.keys().hasOnly([
          'username',
          'display_name',
          'avatar_url',
          'bio',
          'created_at',
          'updated_at'
        ]);
      allow delete: if isAdmin();
    }

    match /user_roles/{roleId} {
      allow read: if isAdmin() || (signedIn() && (roleId == request.auth.uid || resource.data.user_id == request.auth.uid));
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'average_rating',
              'review_count',
              'comment_count',
              'view_count',
              'like_count',
              'share_count',
              'save_count',
              'updated_at'
            ])
        );
    }

    match /resource_reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && matchesProfileUser(request.resource.data.user_id)
        && request.resource.data.rating is number;
      allow update, delete: if isAdmin() || matchesProfileUser(resource.data.user_id);
    }

    match /resource_comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && matchesProfileUser(request.resource.data.user_id)
        && request.resource.data.content is string;
      allow update, delete: if isAdmin() || matchesProfileUser(resource.data.user_id);
    }

    match /blog_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blog_comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && matchesProfileUser(request.resource.data.author_id)
        && request.resource.data.content is string;
      allow update, delete: if isAdmin() || matchesProfileUser(resource.data.author_id);
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && matchesProfileUser(request.resource.data.author_id);
      allow update: if isAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['like_count', 'reply_count', 'last_activity', 'updated_at'])
        );
      allow delete: if isAdmin();
    }

    match /community_replies/{replyId} {
      allow read: if true;
      allow create: if signedIn()
        && matchesProfileUser(request.resource.data.author_id)
        && request.resource.data.content is string;
      allow update: if isAdmin() || matchesProfileUser(resource.data.author_id);
      allow delete: if isAdmin() || matchesProfileUser(resource.data.author_id);
    }

    match /user_engagements/{engagementId} {
      allow read: if signedIn() && matchesProfileUser(resource.data.user_id);
      allow create: if signedIn() && matchesProfileUser(request.resource.data.user_id);
      allow delete: if signedIn() && matchesProfileUser(resource.data.user_id);
      allow update: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
