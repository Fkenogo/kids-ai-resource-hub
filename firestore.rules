rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminRolePath() {
      return /databases/$(database)/documents/user_roles/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminRolePath())
        && (
          get(adminRolePath()).data.role == 'admin'
          || get(adminRolePath()).data.role == 'moderator'
        );
    }

    function matchesProfileUser(profileId) {
      return signedIn() && (
        profileId == request.auth.uid
        || (
          request.auth.token.email != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/profiles/$(profileId))
          && get(/databases/$(database)/documents/profiles/$(profileId)).data.email == request.auth.token.email
        )
      );
    }

    match /profiles/{profileId} {
      // Full profile documents contain private fields (email). Only the owner
      // and admins may read them; public author data lives in public_profiles.
      allow get: if matchesProfileUser(profileId) || isAdmin();
      // The app resolves legacy profile ids by matching the signed-in email.
      // Queries must be constrained to the caller's own email.
      allow list: if isAdmin()
        || (
          signedIn()
          && request.auth.token.email != null
          && request.auth.token.email_verified == true
          && resource.data.email == request.auth.token.email
        );
      allow create: if signedIn() && request.auth.uid == profileId;
      allow update: if matchesProfileUser(profileId) || isAdmin();
      allow delete: if isAdmin();
    }

    function isValidPublicProfile() {
      // String-only contract: names must render, avatar is an optional string.
      return request.resource.data.keys().hasOnly([
        'username',
        'display_name',
        'avatar_url'
      ])
        && request.resource.data.username is string
        && request.resource.data.username.trim() != ''
        && request.resource.data.display_name is string
        && request.resource.data.display_name.trim() != ''
        && (
          !request.resource.data.keys().hasAny(['avatar_url'])
          || request.resource.data.avatar_url is string
        );
    }

    match /public_profiles/{profileId} {
      // Only fields the public UI renders: author/member name and avatar.
      // Never add email, bio, timestamps, or any private data here.
      allow read: if true;
      allow create, update: if (isAdmin() || matchesProfileUser(profileId))
        && isValidPublicProfile();
      allow delete: if isAdmin();
    }

    match /user_roles/{roleId} {
      allow read: if isAdmin() || (signedIn() && (roleId == request.auth.uid || resource.data.user_id == request.auth.uid));
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      function isValidPublishedResource(data) {
        return data.get('is_approved', false) == false
          || (
            data.get('title', '') is string
            && data.get('title', '').trim() != ''
            && data.get('description', '') is string
            && data.get('description', '').trim() != ''
            && data.get('url', '') is string
            && data.get('url', '').matches('https?://.+')
            && data.get('resource_type', '') is string
            && data.get('resource_type', '').trim() != ''
            && data.get('cost', '') in ['free', 'paid', 'subscription', 'freemium']
            && data.get('age_ranges', []) is list
            && data.get('age_ranges', []).size() > 0
            && data.get('age_ranges', []).hasOnly(['4-7', '8-10', '11-13', '14-17'])
          );
      }

      // Older records without a publication flag remain public. Explicit drafts are private.
      allow get: if isAdmin() || resource.data.get('is_approved', true) == true;
      allow list: if isAdmin() || resource.data.is_approved == true;
      // New records must declare their state so an omitted flag cannot become public by default.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAny(['is_approved'])
        && request.resource.data.is_approved is bool
        && isValidPublishedResource(request.resource.data);
      allow delete: if isAdmin();
      allow update: if (isAdmin() && isValidPublishedResource(request.resource.data))
        || (
          signedIn()
          && resource.data.get('is_approved', true) == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'average_rating',
              'review_count',
              'comment_count',
              'view_count',
              'like_count',
              'share_count',
              'save_count',
              'updated_at'
            ])
        );
    }

    match /resource_reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && matchesProfileUser(request.resource.data.user_id)
        && request.resource.data.rating is number;
      allow update, delete: if isAdmin() || matchesProfileUser(resource.data.user_id);
    }

    match /resource_comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && matchesProfileUser(request.resource.data.user_id)
        && request.resource.data.content is string;
      allow update, delete: if isAdmin() || matchesProfileUser(resource.data.user_id);
    }

    match /blog_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blog_comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && matchesProfileUser(request.resource.data.author_id)
        && request.resource.data.content is string;
      allow update, delete: if isAdmin() || matchesProfileUser(resource.data.author_id);
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && matchesProfileUser(request.resource.data.author_id);
      allow update: if isAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['like_count', 'reply_count', 'last_activity', 'updated_at'])
        );
      allow delete: if isAdmin();
    }

    match /community_replies/{replyId} {
      allow read: if true;
      allow create: if signedIn()
        && matchesProfileUser(request.resource.data.author_id)
        && request.resource.data.content is string;
      allow update: if isAdmin() || matchesProfileUser(resource.data.author_id);
      allow delete: if isAdmin() || matchesProfileUser(resource.data.author_id);
    }

    match /user_engagements/{engagementId} {
      allow read: if signedIn() && matchesProfileUser(resource.data.user_id);
      allow create: if signedIn() && matchesProfileUser(request.resource.data.user_id);
      allow delete: if signedIn() && matchesProfileUser(resource.data.user_id);
      allow update: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
